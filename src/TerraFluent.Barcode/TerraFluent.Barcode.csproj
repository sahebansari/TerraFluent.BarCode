<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>TerraFluent.Barcode</RootNamespace>
    <AssemblyName>TerraFluent.Barcode</AssemblyName>
    <PackageId>TerraFluent.Barcode</PackageId>
    <Title>TerraFluent.Barcode — Dependency-free barcode, QR, Data Matrix, PDF417, Aztec, MaxiCode, DataBar and Micro QR generation for .NET</Title>
    <Description>A fluent, zero-dependency .NET library that generates linear (1D) barcodes and 2D codes: Code 128, GS1-128, Code 39, EAN-13, EAN-8, UPC-A (with EAN-2/EAN-5 add-ons), ITF, ITF-14, Codabar, GS1 DataBar (Omnidirectional, Limited, Expanded), USPS Intelligent Mail, QR codes, Micro QR, rMQR, Data Matrix, PDF417, Aztec and MaxiCode, with human-readable text, styled QR codes (rounded modules, gradients, logos) and a DI-friendly IBarcodeGenerator. Outputs PNG, JPEG, SVG, byte arrays, streams, base64 and data URIs.</Description>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Fails the pack if the public API breaks compared with the last version on nuget.org. -->
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      CA1510, CA1835, CA1845, CA1846, CA1865, CA2249: suggest APIs (ArgumentNullException.ThrowIfNull,
      span overloads, char overloads of string methods) that netstandard2.0 lacks.
      RS0026: Gradient has colour and hex overloads that both default the direction;
      they cannot be confused because the first two parameter types differ.
    -->
    <NoWarn>$(NoWarn);CA1510;CA1835;CA1845;CA1846;CA1865;CA2249;RS0026</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraFluent.Barcode.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
