<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TerraFluent.Barcode.AspNetCore</RootNamespace>
    <AssemblyName>TerraFluent.Barcode.AspNetCore</AssemblyName>
    <PackageId>TerraFluent.Barcode.AspNetCore</PackageId>
    <Title>TerraFluent.Barcode.AspNetCore — Serve barcodes and QR codes from ASP.NET Core</Title>
    <Description>ASP.NET Core integration for TerraFluent.Barcode: a minimal-API endpoint that serves barcodes and QR codes as PNG, JPEG or SVG with size limits, ETags and caching headers; IResult helpers for minimal APIs and controllers; and a Razor tag helper that renders a barcode as an img or inline SVG.</Description>
    <PackageTags>aspnetcore;asp.net-core;minimal-api;tag-helper;razor;barcode;qrcode;qr-code;datamatrix;pdf417;png;svg</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- MIT only: the font licence travels with the TerraFluent.Barcode dependency. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsTrimmable>true</IsTrimmable>
    <!-- RS0026: the Barcode overloads differ in their first parameter (type and value, or a builder), so they cannot be confused. -->
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerraFluent.Barcode\TerraFluent.Barcode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraFluent.Barcode.AspNetCore.Tests" Key="" />
  </ItemGroup>

</Project>
