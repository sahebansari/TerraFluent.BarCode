<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Authors>Saheb Ansari</Authors>
    <Company>Saheb Ansari</Company>
    <Product>TerraFluent.Barcode</Product>
    <Version>1.2.0</Version>
    <!-- Strong-named assemblies keep AssemblyVersion at major.0.0.0 so minor and patch upgrades need no binding redirects. -->
    <AssemblyVersion>$([System.Version]::Parse($(Version.Split('-')[0])).Major).0.0.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 Saheb Ansari</Copyright>
    <PackageLicenseExpression>MIT AND OFL-1.1</PackageLicenseExpression>
    <PackageTags>barcode;qrcode;qr;qr-code;2d-barcode;barcode-generator;qr-generator;code128;code39;ean13;upc;gs1-128;datamatrix;pdf417;png;jpeg;svg;base64;fluent</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/sahebansari/TerraFluent.Barcode</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sahebansari/TerraFluent.Barcode</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>https://github.com/sahebansari/TerraFluent.Barcode/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!--
      Strong naming for consumers that require it (.NET Framework, signed applications).
      The key is public on purpose, as Microsoft's guidance for open-source libraries recommends:
      a strong name is an identity, not a security boundary.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)TerraFluent.Barcode.snk</AssemblyOriginatorKeyFile>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
