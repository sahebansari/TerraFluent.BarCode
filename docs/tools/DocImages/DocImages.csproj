<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the example images used by the documentation site into docs/images. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>TerraFluent.Barcode.DocImages</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TerraFluent.Barcode\TerraFluent.Barcode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\samples\TerraFluent.Barcode.Sample\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
