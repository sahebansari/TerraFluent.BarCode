<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>TerraFluent.Barcode.Benchmarks</RootNamespace>
    <!-- BenchmarkDotNet generates and builds its own project; it needs optimised code to measure. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerraFluent.Barcode\TerraFluent.Barcode.csproj" />
  </ItemGroup>

</Project>
